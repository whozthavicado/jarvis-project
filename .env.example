# Z.E.R.O environment configuration — copy to .env and fill in.
# There is no automatic .env loader (dependency minimalism); load it into
# your shell before running:
#
#     set -a; source .env; set +a
#
# Never commit the real .env — it's gitignored.

# ── Mode switch ──────────────────────────────────────────────────────────────
# "free"      OpenRouter free tier + NVIDIA NIM. $0 cost. The default —
#             leaving TIER_MODE unset means free mode.
# "anthropic" Claude models (Sonnet/Opus/Fable/Haiku). Paid. The upgrade
#             path — flip this one variable and set ANTHROPIC_API_KEY below.
#TIER_MODE=free

# ── Free mode keys (both recommended; each is free to create) ────────────────
# OpenRouter — primary engine for every tier. https://openrouter.ai/keys
# Free-tier models are rate-limited (typically ~20 req/min, ~200 req/day per
# model), which is why the NVIDIA fallback below matters.
OPENROUTER_API_KEY=sk-or-...

# NVIDIA NIM — fallback engine when OpenRouter is rate-limited or a model is
# down. Key is free via the NVIDIA Developer Program: https://build.nvidia.com
NVIDIA_API_KEY=nvapi-...

# ── Pro mode key (only needed when TIER_MODE=anthropic) ──────────────────────
# The app never calls Anthropic in free mode — a Claude Pro/Code subscription
# used for *developing* this project is entirely separate from this key.
#ANTHROPIC_API_KEY=sk-ant-...
